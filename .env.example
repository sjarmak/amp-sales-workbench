AMP_API_KEY=your_amp_api_key_here

# Sales Events API integration
# URL for the sales-events-api service
SALES_EVENTS_API_URL=http://localhost:8080

# Gong data source mode
# Options:
#   - events-api (default): Production mode, uses sales-events-api service
#   - cache: Development/offline mode, uses local JSON cache
#   - mcp: Legacy fallback, uses Gong MCP directly
GONG_SOURCE=events-api

# MCP servers should be configured in your Amp settings
# Gong, Salesforce, and Notion MCPs must be set up separately
